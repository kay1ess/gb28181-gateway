load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "test_support",
    hdrs = ["test_support.h"],
)

cc_test(
    name = "http_response_test",
    srcs = ["http_response_test.cc"],
    deps = [
        ":test_support",
        "//apps/server:responses",
    ],
)

cc_library(
    name = "udp_peer",
    hdrs = ["udp_peer.h"],
    linkopts = select({
        "//third_party:windows": ["ws2_32.lib"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "child_process",
    hdrs = ["child_process.h"],
)

cc_library(
    name = "sdk_flow",
    hdrs = ["sdk_flow.h"],
    deps = ["//:sdk"],
)

cc_test(
    name = "sdk_soak_test",
    timeout = "eternal",
    srcs = ["sdk_soak_test.cc"],
    linkopts = select({
        "//third_party:windows": ["psapi.lib"],
        "//conditions:default": [],
    }),
    tags = [
        "manual",
        "stability",
    ],
    deps = [
        ":child_process",
        ":sdk_flow",
        ":udp_peer",
    ],
)

