{
  "name": "smsplayer",
  "version": "1.3.0",
  "main": "dist/smsplayer.min.js",
  "scripts": {
    "test": "node --test",
    "build": "webpack --mode=production --progress",
    "build:debug": "webpack --mode=development --progress",
    "build:core": "webpack --mode=production --env target=core --progress",
    "build:ui": "webpack --mode=production --env target=ui --progress",
    "verify:bundles": "node scripts/verify-bundles.cjs",
    "benchmark:performance": "node scripts/performance/run.cjs",
    "dev": "webpack serve --mode=development",
    "setup:wasm": "pwsh -NoProfile -File scripts/wasm/setup.ps1",
    "build:wasm": "node scripts/wasm/build.cjs --all",
    "build:wasm:deps": "node scripts/wasm/deps.cjs --all",
    "test:wasm": "node scripts/wasm/verify.cjs",
    "test:wasm:player": "node scripts/wasm/verify-player.cjs",
    "test:wasm:bundles": "node scripts/wasm/verify-bundled-worker.cjs",
    "build:wasm:simd": "node scripts/wasm/build.cjs --simd",
    "test:wasm:pixels": "node scripts/wasm/verify-pixels.cjs",
    "benchmark:pixels": "node scripts/performance/pixels/run.cjs",
    "dev:vue": "vite --config example/vue3/vite.config.mjs",
    "build:vue-demo": "vite build --config example/vue3/vite.config.mjs",
    "typecheck:vue": "tsc --project tests/types/tsconfig.json",
    "verify:release": "node scripts/verify-release.cjs",
    "prepack": "node scripts/verify-release.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.25.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "babel-loader": "^8.3.0",
    "core-js": "^3.38.1",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "jsdom": "^26.1.0",
    "mini-css-extract-plugin": "^2.9.0",
    "style-loader": "^4.0.0",
    "svg-inline-loader": "^0.8.2",
    "typescript": "^5.9.3",
    "url-loader": "^4.1.1",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.2"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false,
    "crypto": false
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.cts",
      "default": "./dist/smsplayer.min.js"
    },
    "./vue": {
      "types": "./vue/index.d.ts",
      "import": "./vue/index.js",
      "default": "./vue/index.js"
    },
    "./ts": {
      "types": "./types/player.d.mts",
      "import": "./types/player.mjs"
    },
    "./core": {
      "types": "./types/core.d.cts",
      "default": "./dist/smsplayer.core.min.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "vue",
    "CHANGELOG.md",
    "UPGRADING.md",
    "src/decoder/wasm/COPYING.LGPLv2.1",
    "types"
  ],
  "bin": {
    "smsplayer-assets": "./vue/copy-assets.cjs"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "types": "./types/index.d.cts"
}
