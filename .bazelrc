common --enable_platform_specific_config
# Native builds. --config selects settings, not a cross compiler.
build:windows --platforms=//build/platforms:windows_x64
# Use Git Bash rather than the Windows WSL launcher named bash.exe.
build:windows --shell_executable="C:/Program Files/Git/bin/bash.exe"
build:windows --cxxopt=/std:c++17
build:windows --cxxopt=/utf-8
build:windows --cxxopt=/Zc:__cplusplus
build:linux --platforms=//build/platforms:linux_x64
build:linux --cxxopt=-std=c++17
build:macos --cxxopt=-std=c++17
# std::filesystem (used by the test suite) requires macOS 10.15+; Apple Silicon
# itself requires 11.0, so target 11.0.
build:macos --macos_minimum_os=11.0
# Run actions locally instead of sandboxed, so build tools installed under
# /opt/homebrew/bin (cmake, ninja, pkg-config) are visible via the host PATH.
build:macos --spawn_strategy=local
build:macos --incompatible_strict_action_env=false
build:macos_arm64 --platforms=//build/platforms:macos_arm64
build:macos_x64 --platforms=//build/platforms:macos_x64

# Linux x86_64 host, Linux ARM64 target (Debian GCC cross compiler).
build:linux_arm64 --platforms=//build/platforms:linux_arm64
build:linux_arm64 --extra_toolchains=@aarch64_linux_gnu//:toolchain
build:linux_arm64 --symlink_prefix=.bazel-output/linux-arm64-
